# Normalize line endings so fresh clones work regardless of core.autocrlf.
# Every file in this repository is stored with LF and must be checked out
# with LF: bash scripts, shell configs, and MSYS2 startup shims fail with
# CRLF working trees.
* text=auto
*.sh text eol=lf
*.ps1 text eol=lf
*.lua text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.env text eol=lf
*.txt text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
LICENSE text eol=lf
