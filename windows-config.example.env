# Local Windows configuration for this repository.
#
# bootstrap.sh creates windows-config.env with the interactive setup UI.
# You can also copy this file manually for non-interactive setup. The local file
# is ignored by Git. Paths may use Git Bash form, for example /c/Users/me.

# Scoop installation and package selection.
DOTFILES_INSTALL_SCOOP="1"
DOTFILES_SCOOP_BUCKETS="extras"
DOTFILES_NERD_FONTS_BUCKET_URL="https://github.com/matthewjberger/scoop-nerd-fonts"
DOTFILES_SCOOP_PACKAGES="git neovim wezterm starship ripgrep fd fzf jq lazygit nodejs Hack-NF"
DOTFILES_UPDATE_SCOOP="0"

# Herdr currently ships a Windows beta installer instead of a Scoop manifest.
DOTFILES_INSTALL_HERDR="1"
DOTFILES_HERDR_INSTALL_URL="https://herdr.dev/install.ps1"

# Keep agent CLIs optional. Their configuration is linked regardless.
DOTFILES_INSTALL_AGENT_CLIS="0"

# Override these only when Windows reports unusual locations.
# DOTFILES_WINDOWS_HOME="/c/Users/your-name"
# DOTFILES_LOCAL_APPDATA="/c/Users/your-name/AppData/Local"
# DOTFILES_APPDATA="/c/Users/your-name/AppData/Roaming"
# DOTFILES_XDG_CONFIG_HOME="/c/Users/your-name/.config"
# DOTFILES_DOTFILES_LINK="/c/Users/your-name/.dotfiles"
# DOTFILES_NVIM_CONFIG_DIR="/c/Users/your-name/AppData/Local/nvim"
# DOTFILES_WEZTERM_CONFIG_DIR="/c/Users/your-name/.config/wezterm"
# DOTFILES_WEZTERM_CONFIG_FILE="/c/Users/your-name/.wezterm.lua"
# DOTFILES_HERDR_CONFIG_DIR="/c/Users/your-name/AppData/Roaming/herdr"
# DOTFILES_CLAUDE_CONFIG_DIR="/c/Users/your-name/.claude"
# DOTFILES_CODEX_CONFIG_DIR="/c/Users/your-name/.codex"
# DOTFILES_OPENCODE_CONFIG_DIR="/c/Users/your-name/.config/opencode"
# DOTFILES_PI_AGENT_DIR="/c/Users/your-name/.pi/agent"

# Link behavior. Directory configs use junctions; individual files use
# symbolic links. Existing real files/directories are moved aside first.
DOTFILES_LINK_MODE="junction"
DOTFILES_BACKUP_EXISTING="1"
DOTFILES_DOTFILES_LINK=""

# Git Bash integration.
DOTFILES_INSTALL_BASH_HOOK="1"
DOTFILES_EDITOR="nvim"
DOTFILES_VISUAL="nvim"

# Windows settings are opt-in. Set DOTFILES_APPLY_WINDOWS_SETTINGS=1 before
# enabling individual settings below.
DOTFILES_APPLY_WINDOWS_SETTINGS="0"
DOTFILES_DARK_MODE="0"
DOTFILES_SHOW_FILE_EXTENSIONS="0"
DOTFILES_SHOW_HIDDEN_FILES="0"
DOTFILES_HIDE_DESKTOP_ICONS="0"
DOTFILES_TASKBAR_AUTO_HIDE="0"
DOTFILES_KEYBOARD_REPEAT="0"
DOTFILES_KEYBOARD_DELAY="0"
DOTFILES_KEYBOARD_SPEED="31"
DOTFILES_RESTART_EXPLORER="0"
