# Local Windows configuration for this repository.
#
# bootstrap.ps1 creates windows-config.env with its interactive setup UI. You
# can also copy this file manually for non-interactive setup. The local file is
# ignored by Git. Paths may use Git Bash form, for example /c/Users/me, or
# native Windows form such as C:\Users\me.

# Package installation. Before installing anything, the bootstrap checks
# whether each declared tool is already available (on PATH, in Scoop, or in
# WinGet) and asks you to confirm the recommended action per tool. Tools that
# are already installed through another source are skipped by default. Scoop
# is the default: every app installs into its own
# versioned directory under ~/scoop/apps/<name>/current with a shim on PATH,
# so installs stay self-contained, easy to update, and never require
# elevation.
DOTFILES_PACKAGE_MANAGER="scoop"
DOTFILES_INSTALL_SCOOP="1"
DOTFILES_SCOOP_BUCKETS="extras"
DOTFILES_NERD_FONTS_BUCKET_URL="https://github.com/matthewjberger/scoop-nerd-fonts"
DOTFILES_SCOOP_PACKAGES="git neovim starship ripgrep fd fzf jq lazygit nodejs"
DOTFILES_UPDATE_SCOOP="0"

# Kun Chen's Agentic Engineering Setup. psmux is a tmux-compatible terminal
# multiplexer for Windows, installed from its dedicated Scoop bucket.
DOTFILES_INSTALL_PSMUX="1"

# WinGet is the alternative. Set DOTFILES_PACKAGE_MANAGER="winget" to install
# official portable archives for Git, Node.js, Neovim, and Starship plus
# user-scope zip packages for the rest, all without elevation.
DOTFILES_WINGET_PACKAGES="git node neovim starship BurntSushi.ripgrep.MSVC sharkdp.fd junegunn.fzf jqlang.jq JesseDuffield.lazygit"
DOTFILES_LOCAL_TOOLS_DIR="/c/Users/your-name/AppData/Local/Programs"
DOTFILES_UPDATE_PACKAGES="0"

# MSYS2 zsh is optional. WinGet installs MSYS2 to C:\msys64 and pacman installs
# zsh; Git Bash and PowerShell remain independent. Zsh runs with the full
# Windows PATH, so tools like herdr, pwsh, and nvim stay available. Launch zsh
# from the MSYS2 shell after bootstrap.
DOTFILES_INSTALL_ZSH="0"

# Oh My Posh is optional. Select it in the setup UI or set this to 1 to install
# it and use the matching prompt theme in zsh.
DOTFILES_INSTALL_OH_MY_POSH="0"
# The color theme shared by Windows Terminal, Neovim, Herdr, zsh, and the
# prompt. Tokyo Night is the recommended default; Rose Pine Moon is the
# alternative. DOTFILES_OH_MY_POSH_THEME follows this choice.
DOTFILES_COLOR_THEME="tokyo-night"

# Herdr currently ships a Windows beta installer instead of a package manifest.
DOTFILES_INSTALL_HERDR="1"
DOTFILES_HERDR_INSTALL_URL="https://herdr.dev/install.ps1"

# Keep agent CLIs optional. Their configuration is linked regardless.
DOTFILES_INSTALL_AGENT_CLIS="0"

# Override these only when Windows reports unusual locations.
# DOTFILES_WINDOWS_HOME="/c/Users/your-name"
# DOTFILES_LOCAL_APPDATA="/c/Users/your-name/AppData/Local"
# DOTFILES_APPDATA="/c/Users/your-name/AppData/Roaming"
# DOTFILES_XDG_CONFIG_HOME="/c/Users/your-name/.config"
# DOTFILES_DOTFILES_LINK="/c/Users/your-name/.dotfiles"
# DOTFILES_NVIM_CONFIG_DIR="/c/Users/your-name/AppData/Local/nvim"
# DOTFILES_HERDR_CONFIG_DIR="/c/Users/your-name/AppData/Roaming/herdr"
# DOTFILES_CLAUDE_CONFIG_DIR="/c/Users/your-name/.claude"
# DOTFILES_CODEX_CONFIG_DIR="/c/Users/your-name/.codex"
# DOTFILES_OPENCODE_CONFIG_DIR="/c/Users/your-name/.config/opencode"
# DOTFILES_PI_AGENT_DIR="/c/Users/your-name/.pi/agent"

# Link behavior. Directory configs use junctions and individual files use hard
# links by default, avoiding elevation on the same volume. Symbolic mode uses
# symbolic links for every target and may require Developer Mode or elevation.
DOTFILES_LINK_MODE="junction"
DOTFILES_BACKUP_EXISTING="1"
DOTFILES_DOTFILES_LINK=""

# Git Bash integration.
DOTFILES_INSTALL_BASH_HOOK="1"
DOTFILES_EDITOR="nvim"
DOTFILES_VISUAL="nvim"

# Windows settings are opt-in. Set DOTFILES_APPLY_WINDOWS_SETTINGS=1 before
# enabling individual settings below.
DOTFILES_APPLY_WINDOWS_SETTINGS="0"
DOTFILES_DARK_MODE="0"
DOTFILES_SHOW_FILE_EXTENSIONS="0"
DOTFILES_SHOW_HIDDEN_FILES="0"
DOTFILES_HIDE_DESKTOP_ICONS="0"
DOTFILES_TASKBAR_AUTO_HIDE="0"
DOTFILES_KEYBOARD_REPEAT="0"
DOTFILES_KEYBOARD_DELAY="0"
DOTFILES_KEYBOARD_SPEED="31"
DOTFILES_RESTART_EXPLORER="0"
