{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 2,
  "final_space": true,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "os",
          "style": "plain",
          "foreground": "#7dcfff",
          "template": "{{ .Icon }} "
        },
        {
          "type": "path",
          "style": "plain",
          "foreground": "#7aa2f7",
          "template": "{{ .Path }} "
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "#bb9af7",
          "template": "{{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} +{{ .Working.Changed }}{{ end }}{{ if .Staging.Changed }} ~{{ .Staging.Changed }}{{ end }}{{ if .Conflicts }} ={{ .Conflicts }}{{ end }}{{ if .Stash.Count }} [{{ .Stash.Count }}]{{ end }} "
        },
        {
          "type": "node",
          "style": "plain",
          "foreground": "#9ece6a",
          "template": "{{ if .Full }}⬢ {{ .Full }} {{ end }}"
        },
        {
          "type": "status",
          "style": "plain",
          "foreground": "#c0caf5",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#f7768e{{ end }}"
          ],
          "template": "{{ if gt .Code 0 }}[{{ .Code }}] {{ end }}"
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "#bb9af7",
          "template": "> "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "right",
      "segments": [
        {
          "type": "execution_time",
          "style": "plain",
          "foreground": "#565f89",
          "template": "{{ .FormattedMs }} ",
          "properties": {
            "threshold": 2000
          }
        },
        {
          "type": "time",
          "style": "plain",
          "foreground": "#7dcfff",
          "template": "{{ .CurrentDate | date .Format }}",
          "properties": {
            "time_format": "15:04"
          }
        }
      ]
    }
  ]
}
